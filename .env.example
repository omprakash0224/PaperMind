# Root .env — shell-level variables read by docker compose for build args.
# These are NOT the same as the service .env files (backend/.env, frontend/.env).
#
# How to use:
#   cp .env.example .env
#   # fill in values, then:
#   docker compose --env-file .env up --build

# ── Next.js build args (baked into the frontend bundle at build time) ─────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Runtime secrets passed to frontend container ──────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
